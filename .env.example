# GEMINI_API_KEY: Required for server-side Gemini AI tool orchestration & audio transcription.
# Configure in AI Studio Settings > Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: Hosted applet URL injected automatically by AI Studio.
APP_URL="MY_APP_URL"
PUBLIC_BASE_URL=""

# MURF_API_KEY: Murf Falcon TTS API key (server-only).
MURF_API_KEY=""
MURF_API_KEY_ALT=""
MURF_VOICE_ID="en-IN-anisha"

# AGORA: Real-time voice transport and Conversational AI credentials (server-only except AGORA_APP_ID returned via session endpoint).
AGORA_APP_ID=""
AGORA_APP_CERTIFICATE=""
AGORA_CUSTOMER_ID=""
AGORA_CUSTOMER_SECRET=""
AGORA_AGENT_UID="990104"

# LLM_SHARED_SECRET: Authenticates Agora Conversational AI requests to /api/llm.
LLM_SHARED_SECRET=""
